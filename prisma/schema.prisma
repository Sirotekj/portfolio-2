generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectCategory {
  print
  digital
  personal
  logo
}

/// Admin uživatelé pro /admin → /edit.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}


/// Globální nastavení webu (SEO, branding, patička, formulář).
model SiteSettings {
  id               Int    @id @default(1)
  siteTitle        String  @default("")
  siteTitleEn      String? @map("site_title_en")
  siteDescription  String  @default("") @db.Text
  siteDescriptionEn String? @map("site_description_en") @db.Text
  favicon          String  @default("")
  logo             String  @default("")
  ogImage          String  @default("")
  keywords         String  @default("")
  keywordsEn       String? @map("keywords_en")
  author           String  @default("")
  contactHeader    String  @default("Kontakt")
  contactHeaderEn  String? @map("contact_header_en")
  contactEmail     String  @default("")
  contactLocation  String  @default("")
  contactPhone     String  @default("")
  formHeader       String  @default("Kontaktní formulář")
  formHeaderEn     String? @map("form_header_en")
  formNameLabel    String  @default("Jméno")
  formNameLabelEn  String? @map("form_name_label_en")
  formEmailLabel   String  @default("Váš mail")
  formEmailLabelEn String? @map("form_email_label_en")
  formMessageLabel String  @default("Zpráva")
  formMessageLabelEn String? @map("form_message_label_en")
  formSubmitLabel  String  @default("Odeslat")
  formSubmitLabelEn String? @map("form_submit_label_en")

  @@map("site_settings")
}

/// Stránka O mně – úvodní text a foto.
model AboutPage {
  id        Int      @id @default(1)
  photo     String   @default("")
  intro     String   @db.Text
  introEn   String?  @map("intro_en") @db.Text

  @@map("about_page")
}

model Hobby {
  id        Int     @id @default(autoincrement())
  name      String
  nameEn    String? @map("name_en")
  sortOrder Int     @default(0)

  @@map("hobbies")
}

model Skill {
  id        Int     @id @default(autoincrement())
  name      String
  nameEn    String? @map("name_en")
  level     Int
  sortOrder Int     @default(0)

  @@map("skills")
}

model Language {
  id        Int     @id @default(autoincrement())
  name      String
  nameEn    String? @map("name_en")
  level     Int
  sortOrder Int     @default(0)

  @@map("languages")
}

model Education {
  id        Int     @id @default(autoincrement())
  years     String
  school    String  @db.Text
  schoolEn  String? @map("school_en") @db.Text
  sortOrder Int     @default(0)

  @@map("education")
}

model JobExperience {
  id            Int     @id @default(autoincrement())
  years         String
  description   String  @db.Text
  descriptionEn String? @map("description_en") @db.Text
  sortOrder     Int     @default(0)

  @@map("job_experiences")
}

/// Úvodní text na homepage portfolia.
model PortfolioPage {
  id      Int     @id @default(1)
  intro   String  @db.Text
  introEn String? @map("intro_en") @db.Text

  @@map("portfolio_page")
}

model Project {
  id          Int              @id @default(autoincrement())
  title       String
  titleEn     String?          @map("title_en")
  image       String
  imageWidth  Int?
  imageHeight Int?
  description String           @default("") @db.Text
  descriptionEn String?        @map("description_en") @db.Text
  category    ProjectCategory?
  gallery     String[]
  video       String           @default("")
  videoWidth  Int?             @map("video_width")
  videoHeight Int?             @map("video_height")
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("projects")
}

model BlogPost {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  slugEn      String?   @unique @map("slug_en")
  title       String
  titleEn     String?   @map("title_en")
  image       String    @default("")
  intro       String    @db.Text
  introEn     String?   @map("intro_en") @db.Text
  content     String    @db.Text
  contentEn   String?   @map("content_en") @db.Text
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("blog_posts")
}
